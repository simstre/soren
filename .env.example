# Backend Configuration
SOREN_BROKER_MODE=mock          # "mock" for development, "ib" for Interactive Brokers
SOREN_DEBUG=true
SOREN_STARTING_BALANCE=100000.0
SOREN_IB_HOST=127.0.0.1
SOREN_IB_PORT=7497              # 7497 for TWS paper, 4002 for IB Gateway paper
SOREN_IB_CLIENT_ID=1
SOREN_MAX_POSITION_PCT=0.05     # 5% of account per trade
SOREN_MAX_EXPOSURE_PCT=0.25     # 25% total exposure
SOREN_RISK_PER_TRADE_PCT=0.01   # 1% risk per trade
SOREN_DEFAULT_TIMEFRAME=5m

# Frontend Configuration (frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/stream
